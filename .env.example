# Port the app (frontend + API) listens on.
PORT=3000

# Public URL of the site. Used for payment redirects and SMS links.
APP_URL=http://localhost:3000

# REQUIRED in production: password for the owner dashboard at /admin.
ADMIN_PASSWORD=change-me

# Optional: secret for signing sessions. Auto-generated into data/ if left empty.
SESSION_SECRET=

# Optional: where the SQLite database and uploaded inspiration photos are stored.
DATA_DIR=data

# Optional: Paystack secret key (sk_live_... / sk_test_...) to take deposits and shop payments.
# Set the webhook URL in your Paystack dashboard to  <APP_URL>/api/payments/webhook
PAYSTACK_SECRET_KEY=

# Optional: Termii (https://termii.com) for OTP sign-in codes, reminders and owner alerts by SMS.
TERMII_API_KEY=
TERMII_SENDER_ID=RossyBraids
# Salon owner's number (e.g. 2348137989405) to receive new booking/order alerts.
OWNER_PHONE=
